# Required
NODE_ENV=production
PORT=3000
JWT_SECRET=
DATABASE_URL=
REDIS_URL=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# SePay.vn Webhook (Xác nhận chuyển khoản ngân hàng MB Bank / VietQR tự động)
# Bắt buộc để webhook SePay hoạt động; thiếu key sẽ trả 503 và không ghi nhận thanh toán.
# Tạo API Key trong SePay Dashboard và cấu hình cùng giá trị trên Vercel:
SEPAY_API_KEY=

# Google Gemini (soạn thư chúc mừng bằng AI; bỏ trống thì dùng thư mẫu của MCNA)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Mô hình bán hàng
# direct (mặc định): tài khoản học viên do MCNA tạo từ bảng "đã thanh toán"; ẩn tự đăng ký, quét QR, duyệt đơn.
# self_service: mở lại luồng học viên tự đăng ký, quét QR và admin duyệt.
SALES_MODE=direct
# Mật khẩu mặc định điền sẵn khi nhập danh sách đã thanh toán (tối thiểu 8 ký tự). Học viên phải đổi ở lần đăng nhập đầu.
DEFAULT_STUDENT_PASSWORD=
# Số điện thoại hỗ trợ in trong email xếp lớp, email tài khoản và trang đăng nhập.
SUPPORT_PHONE=0939.866.825
# true: học viên được tải tệp đính kèm của bài tập về nhà. Mặc định chỉ xem trực tuyến.
ALLOW_HOMEWORK_DOWNLOAD=false

# Optional
DISABLE_RATE_LIMIT=
# Seed sinh them du lieu demo (20 giang vien, 40 khoa hoc, 300 hoc vien).
# Bo trong: database moi chi co 3 tai khoan goc va catalog that cua mcna.vn.
SEED_DEMO_DATA=

# Google Workspace Email Provisioning
SCHOOL_EMAIL_DOMAIN=mcna.edu.vn
GOOGLE_ADMIN_EMAIL=admin@mcna.edu.vn
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
LMS_LOGIN_URL=https://lms.mcna.vn
APP_URL=https://lms.mcna.vn

# SMTP gửi email cho học viên (tài khoản, xếp lớp, xác nhận thanh toán).
# Hộp thư @mcna.vn nằm trên OneMail: mail.mcna.vn, cổng 465. smtp.gmail.com không nhận đăng nhập @mcna.vn.
# Thiếu SMTP_HOST / SMTP_USER / SMTP_PASS thì email KHÔNG được gửi, chỉ ghi vào scratch/emails.log.
SMTP_HOST=mail.mcna.vn
SMTP_PORT=465
SMTP_USER=noreply@mcna.vn
SMTP_PASS=
SMTP_FROM="Học Viện Công Nghệ MCNA" <noreply@mcna.vn>

# Tài liệu buổi học: Supabase Storage (bucket private). Thiếu SUPABASE_* thì file lưu tại MATERIALS_DIR (mặc định storage/materials).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=lms-materials
MATERIALS_DIR=

# Kết nối CRM MCNA (hợp đồng: docs/crm-integration.md)
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
CRM_API_KEY=
CRM_INBOUND_SECRET=
CRM_SIGNATURE_TOLERANCE_SECONDS=300
# Optional read-only pull source for "Học viên & Xếp lớp → Lấy từ CRM".
# Use a dedicated PostgreSQL role with SELECT on public.revenue_records ONLY. Never use the LMS database URL.
# Remote connections verify TLS; add the provider's CA certificate (PEM) only if required.
CRM_DATABASE_URL=
CRM_DATABASE_CA_CERT=
# Vercel Cron / self-hosted job endpoint authentication
CRON_SECRET=
