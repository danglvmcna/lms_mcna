{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    { "path": "/api/internal/jobs/crm-outbox", "schedule": "*/5 * * * *" },
    { "path": "/api/internal/jobs/attendance-risk", "schedule": "17 * * * *" }
  ]
}
